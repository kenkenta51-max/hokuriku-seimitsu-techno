# 公開URL。metadata、canonical、OGPの基準URLに使用します。
NEXT_PUBLIC_SITE_URL=

# microCMSのお知らせ取得用設定。接続開始までは空欄のままにします。
MICROCMS_SERVICE_DOMAIN=
MICROCMS_API_KEY=
MICROCMS_PREVIEW_SECRET=

# フォーム送信方式と通知先。送信基盤確定までは未接続にします。
CONTACT_MODE=
CONTACT_PROVIDER=
CONTACT_GENERAL_TO=
CONTACT_TECHNICAL_TO=
CONTACT_RECRUIT_TO=
MAIL_FROM=
MAIL_API_KEY=

# 図面ファイル用の非公開ストレージ。基盤と保存方針確定までは未接続にします。
STORAGE_PROVIDER=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_RETENTION_DAYS=

# GA4とCookie同意。方針確定までは未接続にします。
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_COOKIE_CONSENT_ENABLED=
